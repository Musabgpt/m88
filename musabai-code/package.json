{
  "name": "musabai-code",
  "displayName": "MusabAI Code",
  "description": "Free Cursor-style AI for VS Code: Agent, Plan and Ask chat, Ctrl+K inline edits, Tab autocomplete, terminal and GitHub tools, using free and local models.",
  "version": "0.1.0",
  "publisher": "musabai",
  "private": true,
  "engines": {
    "vscode": "^1.105.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/webview/tsconfig.json --noEmit",
    "test": "node scripts/build.mjs --tests && node --enable-source-maps --test --test-concurrency=4 dist-test/*.test.js",
    "test:integration": "node scripts/build.mjs && node test/integration/run.mjs",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies --skip-license --allow-missing-repository -o dist/musabai-code.vsix"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/vscode": "1.105.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "marked": "18.1.1"
  }
}
