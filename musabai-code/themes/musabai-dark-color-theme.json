    "activityBarTop.activeBorder": "#4f8cff",
    "sideBar.background": "#101216",
    "sideBar.foreground": "#c3c7d1",
    "sideBar.border": "#23262e",
    "sideBarTitle.foreground": "#e6e9ef",
    "sideBarSectionHeader.background": "#101216",
    "sideBarSectionHeader.border": "#23262e",
    "sideBarSectionHeader.foreground": "#aab0bd",
    "list.hoverBackground": "#1d212a",
    "list.activeSelectionBackground": "#24324f",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#1f2633",
    "list.focusOutline": "#4f8cff66",
    "list.highlightForeground": "#6ea4ff",
    "tree.indentGuidesStroke": "#2a2e37",
    "panel.background": "#101216",
    "panel.border": "#23262e",
    "panelTitle.activeBorder": "#4f8cff",
    "panelTitle.activeForeground": "#e6e9ef",
    "panelTitle.inactiveForeground": "#7d8494",
    "statusBar.background": "#0e1013",
    "statusBar.foreground": "#9aa1af",
    "statusBar.border": "#23262e",
    "statusBar.noFolderBackground": "#0e1013",
    "statusBar.debuggingBackground": "#2a4f8f",
    "statusBarItem.remoteBackground": "#4f8cff",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBarItem.hoverBackground": "#1d212a",
    "button.background": "#4f8cff",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#6a9dff",
    "button.secondaryBackground": "#262a33",
    "button.secondaryForeground": "#d5d8e0",
    "button.secondaryHoverBackground": "#2f3440",
    "input.background": "#191c22",
    "input.border": "#2a2e37",
    "input.foreground": "#d5d8e0",
    "input.placeholderForeground": "#666d7b",
    "inputOption.activeBorder": "#4f8cff",
    "dropdown.background": "#191c22",
    "dropdown.border": "#2a2e37",
    "quickInput.background": "#181b21",
    "quickInputList.focusBackground": "#24324f",
    "pickerGroup.foreground": "#6ea4ff",
    "pickerGroup.border": "#23262e",
    "badge.background": "#2a3550",
