    "diffEditor.insertedTextBackground": "#2ea04340",
    "diffEditor.removedLineBackground": "#f8514924",
    "diffEditor.removedTextBackground": "#f8514940",
    "diffEditor.removedTextBorder": "#f8514966",
    "editorGroup.border": "#23262e",
