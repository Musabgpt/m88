    "progressBar.background": "#4f8cff",
    "scrollbarSlider.background": "#ffffff14",
    "scrollbarSlider.hoverBackground": "#ffffff22",
    "scrollbarSlider.activeBackground": "#ffffff30",
    "terminal.background": "#101216",
    "terminal.foreground": "#d0d4dc",
    "terminalCursor.foreground": "#6ea4ff",
    "terminal.ansiBlack": "#1d2027",
    "terminal.ansiRed": "#f2777a",
    "terminal.ansiGreen": "#7fd18a",
    "terminal.ansiYellow": "#e5c07b",
    "terminal.ansiBlue": "#6ea4ff",
    "terminal.ansiMagenta": "#c792ea",
    "terminal.ansiCyan": "#56d4c4",
    "terminal.ansiWhite": "#d0d4dc",
    "terminal.ansiBrightBlack": "#5c6370",
    "terminal.ansiBrightRed": "#ff8f92",
    "terminal.ansiBrightGreen": "#9be3a4",
    "terminal.ansiBrightYellow": "#f0d08e",
    "terminal.ansiBrightBlue": "#8cb8ff",
    "terminal.ansiBrightMagenta": "#d7a9f2",
    "terminal.ansiBrightCyan": "#7fe3d6",
    "terminal.ansiBrightWhite": "#ffffff",
