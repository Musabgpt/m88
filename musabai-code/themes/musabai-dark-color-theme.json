    "commandCenter.background": "#181b21",
    "commandCenter.border": "#23262e",
    "commandCenter.foreground": "#aab0bd",
    "activityBar.background": "#101216",
    "activityBar.foreground": "#e6e9ef",
    "activityBar.inactiveForeground": "#6b7280",
    "activityBar.border": "#23262e",
    "activityBar.activeBorder": "#4f8cff",
    "activityBarBadge.background": "#4f8cff",
    "activityBarBadge.foreground": "#ffffff",
    "activityBarTop.foreground": "#e6e9ef",
