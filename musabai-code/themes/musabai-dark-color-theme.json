    "gitDecoration.modifiedResourceForeground": "#8cb8ff",
    "gitDecoration.deletedResourceForeground": "#f2777a",
    "gitDecoration.untrackedResourceForeground": "#7fd18a",
    "gitDecoration.ignoredResourceForeground": "#5c6370",
    "gitDecoration.conflictingResourceForeground": "#e5c07b",
    "notifications.background": "#181b21",
    "notifications.border": "#23262e",
    "notificationCenterHeader.background": "#1d212a",
    "menu.background": "#181b21",
    "menu.selectionBackground": "#24324f",
    "menu.separatorBackground": "#23262e",
    "menu.border": "#23262e",
    "breadcrumb.foreground": "#7d8494",
    "breadcrumb.focusForeground": "#d5d8e0",
    "minimap.background": "#14161b",
    "peekView.border": "#4f8cff",
    "peekViewEditor.background": "#171a20",
    "peekViewResult.background": "#181b21",
    "peekViewTitle.background": "#181b21",
    "welcomePage.tileBackground": "#181b21",
    "walkThrough.embeddedEditorBackground": "#181b21",
    "sash.hoverBorder": "#4f8cff"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f6776",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#c792ea"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#a5d6a7"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f5a97f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#56d4c4"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#d5d8e0"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#9fc5ff"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#f5a97f"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#f0c987"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#f2777a"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#82aaff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d5d8e0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d5d8e0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7fd18a"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f2777a"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8cb8ff"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#f0c987",
    "property": "#9fc5ff",
    "enumMember": "#f5a97f",
    "type": "#56d4c4",
    "class": "#56d4c4",
    "interface": "#56d4c4",
    "function": "#82aaff",
    "method": "#82aaff",
    "variable.readonly": "#f5a97f",
    "namespace": "#56d4c4"
  }
}
