    "tab.border": "#101216",
    "tab.activeBorderTop": "#4f8cff",
    "tab.hoverBackground": "#1a1d24",
    "tab.unfocusedActiveBorderTop": "#4f8cff55",
    "titleBar.activeBackground": "#0e1013",
    "titleBar.inactiveBackground": "#0e1013",
    "titleBar.activeForeground": "#c9cdd6",
